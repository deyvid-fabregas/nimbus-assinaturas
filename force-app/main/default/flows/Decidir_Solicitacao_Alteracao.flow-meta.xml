<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>US-04. Screen Flow de decisao. A decisao e aplicada pelo SubscriptionDecisionAction, que valida no servidor Custom Permission do nivel, designacao, segregacao de funcoes, estado e ciclo. Acessar o Flow por URL direta nao contorna essas regras.</description>
    <environments>Default</environments>
    <interviewLabel>Decidir solicitação de alteração {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Decidir solicitação de alteração</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <actionCalls>
        <name>Load_Summary</name>
        <label>Obter resumo da solicitação</label>
        <locationX>176</locationX>
        <locationY>50</locationY>
        <actionName>SubscriptionRequestSummaryAction</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Check_Can_Decide</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>requestId</name>
            <value><elementReference>recordId</elementReference></value>
        </inputParameters>
        <outputParameters>
            <assignToReference>varLoadOk</assignToReference>
            <name>success</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varMessage</assignToReference>
            <name>message</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varCycle</assignToReference>
            <name>cycle</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varSummaryHtml</assignToReference>
            <name>summaryHtml</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varItemsHtml</assignToReference>
            <name>itemsHtml</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varCanSubmit</assignToReference>
            <name>canSubmit</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varCanDecide</assignToReference>
            <name>canDecide</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varCanApply</assignToReference>
            <name>canApply</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varCanReopen</assignToReference>
            <name>canReopen</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varUnavailable</assignToReference>
            <name>unavailableReason</name>
        </outputParameters>
        <nameSegment>SubscriptionRequestSummaryAction</nameSegment>
        <versionSegment>1</versionSegment>
    </actionCalls>
    <decisions>
        <name>Check_Can_Decide</name>
        <label>Pode decidir?</label>
        <locationX>176</locationX>
        <locationY>200</locationY>
        <defaultConnector>
            <targetReference>Unavailable_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Não</defaultConnectorLabel>
        <rules>
            <name>Check_Can_Decide_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCanDecide</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Decision_Screen</targetReference>
            </connector>
            <label>Sim</label>
        </rules>
    </decisions>
    <screens>
        <name>Decision_Screen</name>
        <label>Decidir solicitação</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Do_Decide</targetReference>
        </connector>
        <fields>
            <name>Summary_Text</name>
            <fieldText>{!varSummaryHtml}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Items_Text</name>
            <fieldText>{!varItemsHtml}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Decision_Choice</name>
            <choiceReferences>Choice_Approve</choiceReferences>
            <choiceReferences>Choice_Reject</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Decisão</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Reject_Reason</name>
            <fieldText>Motivo da rejeição (obrigatório ao rejeitar)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>Decision_Choice</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue>
                        <stringValue>Rejeitada</stringValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <actionCalls>
        <name>Do_Decide</name>
        <label>Registrar decisão</label>
        <locationX>176</locationX>
        <locationY>500</locationY>
        <actionName>SubscriptionDecisionAction</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Result_Screen</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Error_Screen</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>requestId</name>
            <value><elementReference>recordId</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>cycle</name>
            <value><elementReference>varCycle</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>decision</name>
            <value><elementReference>Decision_Choice</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>reason</name>
            <value><elementReference>Reject_Reason</elementReference></value>
        </inputParameters>
        <outputParameters>
            <assignToReference>varSuccess</assignToReference>
            <name>success</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varMessage</assignToReference>
            <name>message</name>
        </outputParameters>
        <nameSegment>SubscriptionDecisionAction</nameSegment>
        <versionSegment>1</versionSegment>
    </actionCalls>
    <screens>
        <name>Result_Screen</name>
        <label>Resultado da decisão</label>
        <locationX>176</locationX>
        <locationY>650</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Result_Text</name>
            <fieldText>&lt;p&gt;{!varMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Unavailable_Screen</name>
        <label>Ação indisponível</label>
        <locationX>176</locationX>
        <locationY>800</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Unavailable_Text</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Esta ação não está disponível.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;{!varUnavailable}&lt;/p&gt;&lt;p&gt;{!varMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Error_Screen</name>
        <label>Não foi possível concluir</label>
        <locationX>176</locationX>
        <locationY>950</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Error_Text</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Não foi possível concluir a ação.&lt;/b&gt;&lt;/p&gt;&lt;p&gt;{!$Flow.FaultMessage}&lt;/p&gt;&lt;p&gt;Nada foi alterado além do que a mensagem indicar. Se o problema persistir, contate o administrador.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <choices>
        <name>Choice_Approve</name>
        <choiceText>Aprovar</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Aprovada</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Reject</name>
        <choiceText>Rejeitar</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Rejeitada</stringValue>
        </value>
    </choices>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
