    <decisions>
        <name>Check_Can_Submit</name>
        <label>Pode enviar?</label>
        <locationX>176</locationX>
        <locationY>200</locationY>
        <defaultConnector>
            <targetReference>Unavailable_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Não</defaultConnectorLabel>
        <rules>
            <name>Check_Can_Submit_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCanSubmit</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Confirm_Screen</targetReference>
            </connector>
            <label>Sim</label>
        </rules>
    </decisions>
