<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Quantidade_Positiva</fullName>
    <active>true</active>
    <description>Quantidade &gt;= 1.</description>
    <errorConditionFormula>OR(ISBLANK(Quantidade__c), Quantidade__c &lt; 1)</errorConditionFormula>
    <errorDisplayField>Quantidade__c</errorDisplayField>
    <errorMessage>A quantidade deve ser um inteiro positivo.</errorMessage>
</ValidationRule>
